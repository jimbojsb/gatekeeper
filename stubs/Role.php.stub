<?php

namespace App\Authorization;

/*
|--------------------------------------------------------------------------
| Roles
|--------------------------------------------------------------------------
|
| Every role a user can hold. Add a case per role.
|
| The case value is what gets stored in the user's roles column, so pick
| short, stable, lowercase strings. Renaming a value orphans every user
| who holds it; treat that like a data migration.
|
| Keep this enum a plain list of identifiers with no methods. What each
| role grants lives in Registry.php.
|
| SuperAdmin is the super administrator role named in
| config/gatekeeper.php. Holders pass every Gate check while
| super_admin_enabled is true. To drop the role entirely, disable it and
| delete this case.
|
*/

enum Role: string
{
    case SuperAdmin = 'super-admin';
    case Admin = 'admin';
}
