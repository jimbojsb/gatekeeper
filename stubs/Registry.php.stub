<?php

namespace App\Authorization;

use BackedEnum;
use Jimbojsb\Gatekeeper\Contracts\PermissionRegistry;

/*
|--------------------------------------------------------------------------
| Permission Registry
|--------------------------------------------------------------------------
|
| Maps each role to the permissions it grants. Add an arm to the match for
| each role that grants something. Any role without an arm, including the
| super administrator, falls through to the default and grants nothing.
|
| A role can include everything another role grants by spreading it:
|
|     Role::Writer => [Permission::WriteDrafts],
|     Role::Editor => [...$this->grantedBy(Role::Writer), Permission::ManagePosts],
|
| Duplicates are fine; a user's permissions are deduplicated across roles.
|
| The super administrator role grants no permissions. Its bypass is a Gate
| rule, not a permission: every Gate check (can(), @can, can: middleware,
| policies) allows a super admin, while hasPermission() reports only what
| this registry maps.
|
| This class is a singleton. Keep it stateless.
|
*/

class Registry implements PermissionRegistry
{
    public function grantedBy(BackedEnum $role): array
    {
        return match ($role) {
            Role::Admin => Permission::cases(),
            default => [],
        };
    }
}
